# Prefer: python scripts/init_env.py (generates secrets, preserves existing .env).
APP_ENV=development
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://travelcrm:replace-with-generated-password@127.0.0.1:5432/travelcrm
JWT_SECRET_KEY=replace-with-random-secret-at-least-32-bytes
COOKIE_SECURE=false
SEED_DEMO=true
DEMO_PASSWORD=replace-with-generated-demo-password
BACKEND_PORT=8000
PUBLIC_APP_URL=http://localhost:8080
# Override for deployment; browser traffic uses one origin through Vite/nginx.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
